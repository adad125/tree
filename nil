  25,22,18,24,
  40,39,48,45,
  38,44,43,35
), byrow = TRUE, ncol = 4)

sample.means  = rowMeans(data)
sample.ranges = apply(data, 1, function(x) max(x) - min(x))

Xbarbar = mean(sample.means)
Rbar    = mean(sample.ranges)

A2 = 0.729
D3 = 0 
D4 = 2.282

# X-bar chart limits
CL1  = Xbarbar
UCL1 = Xbarbar + A2 * Rbar
