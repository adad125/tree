#Quiz 2

N <- 2200
n <- 225
c <- 14

# Incoming fraction defective
p <- seq(0, 0.20, by = 0.001)

# Poisson parameter
lambda <- n * p

# Probability of acceptance
Pa <- ppois(c, lambda)

# 1. OC Curve

plot(p * 100, Pa,
     type = "l",
     lwd = 2,
     xlab = "Incoming Fraction Defective (%)",
     ylab = "Probability of Acceptance",
     main = "OC Curve - Poisson Sampling")

#AOQ<-p*Pa       (BOOK)
#AOQL<-max(AOQ)
# 2. AOQ Curve

AOQ <- p * Pa * ((N - n) / N)

# AOQL
AOQL <- max(AOQ)


plot(p * 100, AOQ * 100,
     type = "l",
     lwd = 2,
     xlab = "Incoming Fraction Defective (%)",
     ylab = "AOQ (%)",
     ylim=c(0,4.5),
     main = "AOQ Curve - Poisson Sampling")

# Show AOQL
abline(h = AOQL * 100, lty = 2)


# 3. ATI Curve

ATI <- n * Pa + N * (1 - Pa)

plot(p * 100, ATI,
     type = "l",
     lwd = 2,
     ylim=c(0,2600),
     xlab = "Incoming Fraction Defective (%)",
     ylab = "Average Total Inspection",
     main = "ATI Curve - Poisson Sampling")



