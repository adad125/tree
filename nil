# d-chart (np-chart) for Spark Plug Inspection
# Step 1: Enter the data (number of defectives per lot)
defectives <- c(5,3,15,10,3,16,4,10,5,8,
                5,4,6,8,7,4,6,8,6,10)

n <- 100
lots <- 1:length(defectives)

# Step 2: Overall average proportion defective
p_bar <- sum(defectives) / (length(defectives)*n)

# Step 3: Compute control limits
CL <- n * p_bar
SE <- sqrt(n * p_bar * (1 - p_bar))
UCL <- CL + 3*SE
LCL <- CL - 3*SE
if (LCL < 0) LCL <- 0

# Step 4: Plot the d-chart
plot(lots, defectives, type="b", pch=19, col="blue",
     ylim=c(0, max(defectives,UCL)*1.3),
     main="d-Chart for Spark Plug Inspection",
     xlab="Lot Number", ylab="Number of Defectives")

abline(h=CL, col="darkgreen", lwd=2)
abline(h=UCL, col="red", lty=2, lwd=2)
abline(h=LCL, col="red", lty=2, lwd=2)

legend("topright", legend=c("d_i (each lot)","Center Line","UCL/LCL"),
       col=c("blue","darkgreen","red"),
       lty=c(1,1,2), pch=c(19,NA,NA), bty="n")

# c-chart: number of defects per inspection unit
# Step 1: Enter the data (number of defects per unit)
defects <- c(21,24,16,12,15,5,28,20,31,25,
             20,24,16,19,10,17,13,22,18,39)

units <- 1:length(defects)

# Step 2: Average number of defects
c_bar <- mean(defects)

# Step 3: Compute control limits
CL <- c_bar
UCL <- c_bar + 3*sqrt(c_bar)
LCL <- c_bar - 3*sqrt(c_bar)
if (LCL < 0) LCL <- 0

# Step 4: Plot the c-chart
plot(units, defects, type="b", pch=19, col="blue",
     ylim=c(0, max(defects,UCL)*1.3),
     main="c-Chart",
     xlab="Sample (Unit) Number", ylab="Number of Defects")

abline(h=CL, col="darkgreen", lwd=2)
abline(h=UCL, col="red", lty=2, lwd=2)
abline(h=LCL, col="red", lty=2, lwd=2)

legend("topright", legend=c("c_i (each unit)","Center Line","UCL/LCL"),
       col=c("blue","darkgreen","red"),
       lty=c(1,1,2), pch=c(19,NA,NA), bty="n")

# u-chart: defects per unit (variable number of units)
# Step 1: Enter the data
defects <- c(14,12,20,11,7,10,21,16,19,23,
             12,15,18,9,13,22,17,14,11,20)   # c_i
n_i <- c(10,12,8,13,10,9,11,12,10,9,
         8,10,12,11,9,13,10,8,12,11)         # units inspected

samples <- 1:length(defects)

# Step 2: Defects per unit for each sample
u_i <- defects / n_i

# Step 3: Overall average defects per unit
u_bar <- sum(defects) / sum(n_i)

# Step 4: Control limits (different for each sample)
SE <- sqrt(u_bar / n_i)
UCL <- u_bar + 3*SE
LCL <- u_bar - 3*SE
LCL[LCL < 0] <- 0

# Step 5: Plot the u-chart
plot(samples, u_i, type="b", pch=19, col="blue",
     ylim=c(0, max(u_i,UCL)*1.3),
     main="u-Chart",
     xlab="Sample Number", ylab="Defects per Unit")

abline(h=u_bar, col="darkgreen", lwd=2)
lines(samples, UCL, type="s", col="red", lty=2, lwd=2)
lines(samples, LCL, type="s", col="red", lty=2, lwd=2)

legend("topright", legend=c("u_i (each sample)","Center Line","UCL/LCL"),
       col=c("blue","darkgreen","red"),
       lty=c(1,1,2), pch=c(19,NA,NA), bty="n")

