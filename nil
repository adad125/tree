#Quiz 1

sample_size <- c(500, 400, 300, 150, 600, 450, 750, 800, 900, 1000)
defectives  <- c(25, 42, 35, 16, 15, 40, 72, 81, 82, 100)
samples <- 1:10

p_i   <- defectives / sample_size
p_bar <- sum(defectives) / sum(sample_size)
p_bar

SE  <- sqrt(p_bar * (1 - p_bar) / sample_size)

UCL <- p_bar + 3 * SE
LCL <- p_bar - 3 * SE
LCL[LCL < 0] <- 0

plot(samples, 
     p_i, 
     type = "b", 
     pch = 19, 
     col = "blue", 
     ylim = c(0, 0.25),
     main = "p-Chart for Fraction Defective (Variable Sample Sizes)",
     xlab = "Lot Number", ylab = "Fraction Defective (p_i)")

abline(h = p_bar, col = "darkgreen", lwd = 2)

lines(samples, UCL, col = "red", lty = 2, lwd = 2)
lines(samples, LCL, col = "red", lty = 2, lwd = 2)


legend("topright",
       legend = c("Fraction Defective (p_i)", "Center Line (p-bar)", "Variable UCL/LCL"),
       col = c("blue", "darkgreen", "red"), 
       lty = c(1, 1, 2), 
       pch = c(19, NA, NA))




