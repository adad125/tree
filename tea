#paired t test:
Given: Before and After data
before <- c (70 ,65 ,80 ,75 ,68 ,72 ,77 ,69 ,74 ,71)
after <- c (75 ,70 ,85 ,78 ,72 ,76 ,80 ,73 ,79 ,74)
d <- before - after
n <- length ( d )
dbar <- mean ( d )
sd _ d <- sd ( d )
t _ stat <- dbar / ( sd _ d / sqrt ( n ) )
t _ stat
t _ crit <- qt (0.975 , df = n -1)
t _ crit

#two sample t test: equal variance
group1 <- c (60 ,62 ,59 ,61 ,58 ,63 ,57 ,64 ,60 ,59)
group2 <- c (55 ,54 ,56 ,53 ,57 ,52 ,58 ,54 ,55 ,56)
n1 <- length ( group1 )
n2 <- length ( group2 )
xbar1 <- mean ( group1 )
xbar2 <- mean ( group2 )
s1 <- sd ( group1 )
s2 <- sd ( group2 )
sp2 <- (( n1 -1) * s1 ^2 + ( n2 -1) * s2 ^2) / ( n1 + n2 -2)
sp <- sqrt ( sp2 )
t _ stat <- ( xbar1 - xbar2 ) / ( sp * sqrt (1 / n1 + 1 / n2 ) )
t _ stat
t _ crit <- qt (0.975 , df = n1 + n2 -2)
t _ crit

